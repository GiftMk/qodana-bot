{
	"name": "github-app-template",
	"type": "module",
	"scripts": {
		"start:proxy": "tsx watch src/webhook-proxy-server.ts",
		"start": "tsx watch src/node.ts",
		"build": "esbuild src/lambda.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=dist/lambda.js",
		"postbuild": "powershell ./bundle.ps1",
		"format": "pnpm biome format . --write",
		"format:check": "pnpm biome format",
		"lint": "pnpm biome lint . --write",
		"lint:unsafe": "pnpm biome lint . --write --unsafe",
		"lint:check": "pnpm biome lint .",
		"tidy": "pnpm format && pnpm lint"
	},
	"dependencies": {
		"@octokit/app": "^16.1.2",
		"@octokit/core": "^7.0.6",
		"dotenv": "^17.2.3",
		"envalid": "^8.1.1",
		"express": "^5.1.0",
		"libsodium-wrappers": "^0.7.15",
		"serverless-http": "^4.0.0",
		"winston": "^3.18.3",
		"yaml": "^2.8.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.4",
		"@octokit/types": "^16.0.0",
		"@types/express": "^5.0.5",
		"@types/libsodium-wrappers": "^0.7.14",
		"@types/node": "^24.10.0",
		"esbuild": "^0.27.0",
		"smee-client": "^4.4.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
